PORT=5000
MONGODB_URI=
MONGODB_DB=dataganado
MONGODB_AUTO_INDEX=false
# La API utiliza transacciones: MongoDB Atlas o replica set.
MONGODB_REQUIRE_TRANSACTIONS=true
FRONTEND_URL=
IA_SERVICE_URL=
IA_INTERNAL_TOKEN=
JWT_SECRET=
# JWT_SECRET y CRON_SECRET: minimo 32 caracteres y 16 distintos en produccion.
JWT_ISSUER=ganaderia-romilio-api
JWT_AUDIENCE=ganaderia-romilio-web
JWT_SESSION_SECONDS=28800
RESEND_API_KEY=
EMAIL_FROM=Ganaderia Romilio <notificaciones@alertas.ganaderiaromilio.com>
EMAIL_PASSWORD_RESET_FROM=Ganaderia Romilio <notificaciones@alertas.ganaderiaromilio.com>
EMAIL_ADMIN=
EMAIL_TEST_TO=
# EMAIL_TEST_TO se ignora en produccion.
EMAIL_ALERTS_ENABLED=true
EMAIL_ALERTS_INTERVAL_MS=
EMAIL_DIGEST_INTERVAL_MS=3600000
CRON_MODE=internal
CRON_SECRET=
CRON_LOCK_MS=1800000
IMPORT_MAX_BYTES=5242880
IMPORT_MAX_ROWS_PER_SHEET=5000
IMPORT_MAX_COLUMNS_PER_SHEET=60
IMPORT_MAX_CELL_LENGTH=1000
IMPORT_MAX_SHEETS=8
IMPORT_PARSE_TIMEOUT_MS=15000
IMPORT_WORKER_MEMORY_MB=128
IMPORT_LOCK_TIMEOUT_MS=1200000
IMPORT_PROCESSING_STALE_MINUTES=20
IMPORT_PREVIEW_TTL_HOURS=24
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Importes mensuales USD mostrados por backend y frontend.
PLAN_PRECIO_ESENCIAL_USD=10
PLAN_PRECIO_GESTION_USD=20
PLAN_PRECIO_PRO_USD=35
PLAN_PRECIO_PREMIUM_USD=60
# Cada Price debe estar activo y ser recurrente mensual en USD por el importe del plan.
STRIPE_PRICE_ESENCIAL=
STRIPE_PRICE_GESTION=
STRIPE_PRICE_PRO=
STRIPE_PRICE_PREMIUM=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PRIVATE_BUCKET=
R2_PUBLIC_URL=
R2_ENDPOINT=
